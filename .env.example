# Confirm the canonical production origin before building for deployment.
SITE_URL=https://kslegalconsultants.com

# Enquiry email delivery (netlify/functions/contact.mts). Set these in
# Netlify → Site configuration → Environment variables, NOT in git.
# GoDaddy email: host smtpout.secureserver.net, port 465, user = full mailbox address.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=legal@kslegalconsultants.com
SMTP_PASS=
# Optional: where enquiries go (default legal@kslegalconsultants.com) and the sender address (default SMTP_USER).
MAIL_TO=
MAIL_FROM=
