---
import { Image } from "astro:assets";
import { articles } from "../data/site";
import Icon from "./Icon.astro";
import insightProperty from "../assets/gen/insight-property.webp";
import insightWomen from "../assets/gen/insight-women.webp";
import insightDispute from "../assets/gen/insight-dispute.webp";
const images = { insightProperty, insightWomen, insightDispute };
---

<div class="insights-grid">
  {articles.map((a, i) => (
    <article class="insight-card" data-reveal data-touch style={`--d:${i * 110}ms`}>
      <a class="insight-media" href={`/insights/${a.slug}/`} tabindex="-1" aria-hidden="true">
        <Image
          src={images[a.image as keyof typeof images]}
          alt=""
          widths={[420, 640]}
          sizes="(max-width: 700px) 92vw, 400px"
          format="webp"
          loading="lazy"
        />
      </a>
      <div class="insight-body">
        <div class="article-meta">
          <span class="tag">{a.category}</span>
          <span><Icon name="clock" size={14} /> {a.time}</span>
        </div>
        <h3><a href={`/insights/${a.slug}/`}>{a.title}</a></h3>
        <p>{a.excerpt}</p>
        <a class="text-link" href={`/insights/${a.slug}/`} aria-label={`Read more: ${a.title}`}>
          Read more <Icon name="arrow" size={16} />
        </a>
      </div>
    </article>
  ))}
</div>
