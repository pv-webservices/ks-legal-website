---
import { contact } from "../data/site";
import Icon from "./Icon.astro";
// Exact coordinates: the "BMR Heights" place listing on Google Maps points to the wrong building.
const query = `${contact.geo.lat},${contact.geo.lng}`;
---

<div class="map-card" data-reveal>
  <iframe
    title="KS Legal Consultants office location, Hydernagar, Hyderabad"
    src={`https://maps.google.com/maps?q=${query}&z=17&output=embed`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <a class="map-pill" href={contact.map} target="_blank" rel="noopener noreferrer">
    <Icon name="pin" size={16} /> Open in Google Maps
  </a>
</div>
