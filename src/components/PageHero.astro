---
import { Image } from "astro:assets";
import library from "../assets/illustrations/library.webp";
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  crumbs?: [string, string][];
}
const { title, eyebrow = "KS Legal Consultants", description, crumbs = [] } = Astro.props;
const trail: [string, string][] = [["Home", "/"], ...crumbs, [eyebrow, Astro.url.pathname]];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trail.map(([name, path], i) => ({
    "@type": "ListItem",
    position: i + 1,
    name,
    item: new URL(path, Astro.site).href,
  })),
};
---

<section class="page-hero">
  <div class="page-hero-bg" aria-hidden="true">
    <Image src={library} alt="" widths={[800, 1376]} sizes="100vw" format="webp" loading="eager" data-parallax="0.2" />
  </div>
  <div class="container page-hero-inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {crumbs.map(([label, href]) => (
        <>
          <span aria-hidden="true">/</span>
          <a href={href}>{label}</a>
        </>
      ))}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{eyebrow}</span>
    </nav>
    <p class="kicker kicker-light"><span></span>{eyebrow}</p>
    <h1>{title}</h1>
    {description && <p class="lead">{description}</p>}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c")} />
</section>
