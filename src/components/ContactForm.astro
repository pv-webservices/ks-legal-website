---
import { contact, formEndpoint, practices, whatsapp } from "../data/site";
import { expertise } from "../data/expertise";
import { services } from "../data/services";
import Icon from "./Icon.astro";
interface Props {
  consultation?: boolean;
  selected?: string;
}
const { consultation = false, selected } = Astro.props;
const matterGroups: [string, string[]][] = [
  ["Our Expertise", expertise.map((e) => e.title)],
  ["Our Services", services.map((e) => e.title)],
  [
    "Other Practice Areas",
    practices
      .map((p) => p.title)
      .filter((t) => ![...expertise, ...services].some((e) => e.title === t)),
  ],
];
const thankYouUrl = new URL("/thank-you/", Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const subject = consultation
  ? "New consultation request — KS Legal website"
  : "New website enquiry — KS Legal website";
---

<!-- Posts to FormSubmit. Works without JavaScript; the script below adds inline validation. -->
<form class="inquiry-form" action={formEndpoint} method="POST" data-whatsapp={whatsapp}>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_next" value={thankYouUrl} />
  <input type="hidden" name="_url" value={pageUrl} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_blacklist" value="casino, viagra, seo services, backlinks, guest post" />
  <input type="hidden" name="Form" value={consultation ? "Consultation request" : "Contact enquiry"} />
  <h3>{consultation ? "Request a Consultation" : "Send Us a Message"}</h3>
  <p class="form-intro">
    {consultation
      ? "Tell us a little about your matter. We will contact you to confirm a time."
      : "Fill in your details and we will get back to you soon."}
  </p>
  <div class="form-grid">
    <label>
      Full name <span>*</span>
      <input
        name="name"
        autocomplete="name"
        required
        minlength="2"
        maxlength="100"
        placeholder="Full name"
      />
      <span class="field-error"></span>
    </label>
    <label>
      Email address <span>*</span>
      <input
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="180"
        placeholder="Email address"
      />
      <span class="field-error"></span>
    </label>
    <label>
      Mobile number <span>*</span>
      <input
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        pattern="[+0-9 \(\)\-]{10,20}"
        placeholder="Mobile number"
      />
      <span class="field-error"></span>
    </label>
    {consultation ? (
      <>
        <label>
          Preferred contact method
          <select name="contact_method">
            <option>Phone call</option>
            <option>Email</option>
            <option>WhatsApp</option>
          </select>
        </label>
        <label>
          Practice area
          <select name="practice_area">
            <option>Help me choose</option>
            {matterGroups.map(([label, titles]) => (
              <optgroup label={label}>
                {titles.map((t) => (
                  <option selected={t === selected}>{t}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
        <label>
          Preferred date
          <input name="preferred_date" type="date" />
          <span class="field-error"></span>
        </label>
        <label class="full">
          Preferred time
          <select name="preferred_time">
            <option>Any time — please contact me</option>
            <option>Morning</option>
            <option>Afternoon</option>
            <option>Evening</option>
          </select>
        </label>
      </>
    ) : (
      <label>
        Subject <span>*</span>
        <input
          name="subject"
          required
          minlength="3"
          maxlength="150"
          placeholder="Subject"
        />
        <span class="field-error"></span>
      </label>
    )}
    <label class="full">
      {consultation ? "Short description of your matter" : "Your message"}{" "}
      <span>*</span>
      <textarea
        name="message"
        rows="4"
        required
        minlength="10"
        maxlength="3000"
        placeholder="Share a brief overview. Please avoid confidential details."
      ></textarea>
      <span class="field-error"></span>
    </label>
  </div>
  <!-- Spam trap: FormSubmit silently discards submissions where _honey is filled. -->
  <div class="honeypot" aria-hidden="true">
    <label>
      Leave blank
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <label class="consent">
    <input type="checkbox" name="consent" value="Agreed to be contacted and to the privacy policy" required />
    <span>
      I agree to be contacted about this enquiry and have read the{" "}
      <a href="/privacy-policy/">privacy policy</a>.
      <span class="field-error"></span>
    </span>
  </label>
  <div class="form-actions">
    <button class="button" type="submit" data-via="email">
      <Icon name="send" size={18} />
      <span>{consultation ? "Request Consultation" : "Send Message"}</span>
    </button>
    <button class="button button-whatsapp" type="submit" data-via="whatsapp">
      <Icon name="whatsapp" size={18} />
      <span>Send via WhatsApp</span>
    </button>
  </div>
  <p class="small">
    Your enquiry is delivered securely to {contact.email}. A request does not
    confirm an appointment; we will contact you to discuss availability.
  </p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
<script>
  /** Submissions faster than this are almost always bots. */
  const MIN_FILL_MS = 3000;
  const loadedAt = Date.now();

  type Field = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const messageFor = (field: Field): string => {
    const v = field.validity;
    if (v.valueMissing || (field.required && field.type !== "checkbox" && !field.value.trim()))
      return field.type === "checkbox" ? "Please tick this box to continue." : "Please complete this field.";
    if (v.typeMismatch) return "Please enter a valid email address.";
    if (v.rangeUnderflow) return "Please choose today or a future date.";
    // validity.tooShort only fires after user edits (not autofill), so check length directly.
    const min = Number(field.getAttribute("minlength") || 0);
    if (min && field.value.trim().length < min) return `Please enter at least ${min} characters.`;
    if (field.name === "phone") {
      const digits = field.value.replace(/\D/g, "");
      if (v.patternMismatch || digits.length < 10 || digits.length > 15)
        return "Please enter a valid phone number with 10–15 digits.";
    }
    return v.valid ? "" : "Please check this field.";
  };

  document.querySelectorAll<HTMLFormElement>(".inquiry-form").forEach((form, formIndex) => {
    // Script is running, so take over validation from the browser's native popups.
    form.noValidate = true;
    const fields = [
      ...form.querySelectorAll<Field>('input:not([type="hidden"]):not([name="_honey"]),textarea,select'),
    ];
    const status = form.querySelector<HTMLElement>(".form-status")!;
    const buttons = [...form.querySelectorAll<HTMLButtonElement>('button[type="submit"]')];

    const date = form.querySelector<HTMLInputElement>('[type="date"]');
    if (date) {
      const now = new Date();
      date.min = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
    }
    fields.forEach((field, index) => {
      const error = field.closest("label")?.querySelector<HTMLElement>(".field-error");
      if (!error) return;
      error.id = `form-${formIndex}-error-${index}`;
      field.setAttribute("aria-describedby", error.id);
    });

    const validate = (field: Field): boolean => {
      const message = messageFor(field);
      field.setAttribute("aria-invalid", String(Boolean(message)));
      const error = field.closest("label")?.querySelector(".field-error");
      if (error) error.textContent = message;
      return !message;
    };
    fields.forEach((field) => {
      field.addEventListener("blur", () => field.value && validate(field));
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true") validate(field);
      });
    });

    const setBusy = (busy: boolean) => buttons.forEach((b) => (b.disabled = busy));
    // Re-enable buttons if the visitor returns with the back button (bfcache).
    window.addEventListener("pageshow", () => setBusy(false));

    form.addEventListener("submit", (event) => {
      status.textContent = "";
      status.classList.remove("is-error");
      const fail = (message: string) => {
        event.preventDefault();
        status.textContent = message;
        status.classList.add("is-error");
      };

      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length) {
        invalid[0].focus();
        return fail("Please check the highlighted fields.");
      }
      const honey = form.querySelector<HTMLInputElement>('[name="_honey"]');
      if (honey?.value) return event.preventDefault();

      const via = (event.submitter as HTMLElement | null)?.dataset.via;
      if (via === "whatsapp") {
        event.preventDefault();
        const labels: Record<string, string> = {
          name: "Name",
          email: "Email",
          phone: "Mobile",
          subject: "Subject",
          contact_method: "Preferred contact",
          practice_area: "Practice area",
          preferred_date: "Preferred date",
          preferred_time: "Preferred time",
          message: "Message",
        };
        const summary = [...new FormData(form).entries()]
          .filter(([key, value]) => key in labels && String(value).trim())
          .map(([key, value]) => `${labels[key]}: ${value}`)
          .join("\n");
        const url = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(`Hello KS Legal Consultants,\n\n${summary}`)}`;
        window.open(url, "_blank", "noopener");
        status.textContent =
          "WhatsApp has opened with your message. Press send in WhatsApp to deliver it.";
        return;
      }

      // Only the direct POST needs the bot timer; WhatsApp is sent by the visitor.
      if (Date.now() - loadedAt < MIN_FILL_MS)
        return fail("That was quick! Please review your details and press send again.");

      if (!navigator.onLine)
        return fail("You appear to be offline. Please reconnect and try again, or call +91 7660000787.");

      // Native POST to FormSubmit continues; FormSubmit may show a quick spam check, then returns to /thank-you/.
      status.textContent = "Sending your enquiry…";
      window.setTimeout(() => setBusy(true), 0);
    });
  });
</script>
