---
import Layout from "./Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { Image } from "astro:assets";
import { articles } from "../data/site";
import property from "../assets/property.jpeg";
import insightWomen from "../assets/gen/insight-women.webp";
import insightDispute from "../assets/gen/insight-dispute.webp";
const { frontmatter: f } = Astro.props;
const images = { property, insightWomen, insightDispute };
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: f.title,
  description: f.description,
  datePublished: f.date,
  author: { "@type": "Organization", name: "KS Legal Consultants" },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout title={f.title} description={f.description} schema={schema}>
  <PageHero eyebrow={f.category} crumbs={[["Insights", "/insights/"]]} title={f.title} description={f.description} />
  <section class="section">
    <article class="container editorial">
      <div class="article-meta">
        <time datetime={f.date}>29 September 2026</time>
        <span>{f.readingTime} · KS Legal Consultants</span>
      </div>
      <Image
        class="article-hero-image"
        src={images[f.image as keyof typeof images]}
        alt={f.imageAlt}
        widths={[640, 900]}
        sizes="(max-width: 820px) 92vw, 780px"
        format="webp"
      />
      <slot />
      <div class="article-footer">
        <p class="small">
          General information only. This article does not create an
          advocate–client relationship. Seek advice based on your own facts and
          current law.
        </p>
        <h2>Continue reading</h2>
        <div class="related-links">
          {articles
            .filter((a) => a.title !== f.title)
            .map((a) => (
              <a class="text-link" href={`/insights/${a.slug}/`}>
                {a.title} →
              </a>
            ))}
        </div>
      </div>
    </article>
  </section>
  <CTA />
</Layout>
