---
import Layout from "./Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { Image, getImage } from "astro:assets";
import { articles, siteName } from "../data/site";
import { expertise } from "../data/expertise";
import { services } from "../data/services";
import property from "../assets/editorial/property-awareness-column.jpeg";
import insightWomen from "../assets/illustrations/insight-women.webp";
import insightDispute from "../assets/illustrations/insight-dispute.webp";
const { frontmatter: f } = Astro.props;
const images = { property, insightWomen, insightDispute };
const siteUrl = new URL("/", Astro.site).href;
const heroImage = images[f.image as keyof typeof images];
const schemaImage = await getImage({ src: heroImage, width: 1200, format: "webp" });
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: f.title,
  description: f.description,
  datePublished: f.date,
  dateModified: f.updated ?? f.date,
  image: new URL(schemaImage.src, Astro.site).href,
  author: { "@type": "Person", "@id": `${siteUrl}founder/#person`, name: "Siri Swathi Katragadda", url: `${siteUrl}founder/` },
  publisher: { "@id": `${siteUrl}#organization`, name: siteName },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: "en-IN",
};
const displayDate = new Date(f.date).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
// Internal links from the article to the most relevant service pages.
const related = [...expertise, ...services].filter((s) => (f.related ?? []).includes(s.slug));
---

<Layout title={f.title} description={f.description} schema={schema} ogType="article" publishedTime={f.date}>
  <PageHero eyebrow={f.category} crumbs={[["Insights", "/insights/"]]} title={f.title} description={f.description} />
  <section class="section">
    <article class="container editorial">
      <div class="article-meta">
        <time datetime={f.date}>{displayDate}</time>
        <span>{f.readingTime} · KS Legal Consultants</span>
      </div>
      <Image
        class="article-hero-image"
        src={heroImage}
        alt={f.imageAlt}
        widths={[640, 900]}
        sizes="(max-width: 820px) 92vw, 780px"
        format="webp"
      />
      <slot />
      <div class="article-footer">
        <p class="small">
          General information only. This article does not create an
          advocate–client relationship. Seek advice based on your own facts and
          current law.
        </p>
        {related.length > 0 && (
          <>
            <h2>Related legal services</h2>
            <div class="related-links">
              {related.map((r) => (
                <a class="text-link" href={`/${r.group}/${r.slug}/`}>{r.heading} →</a>
              ))}
            </div>
          </>
        )}
        <h2>Continue reading</h2>
        <div class="related-links">
          {articles
            .filter((a) => a.title !== f.title)
            .map((a) => (
              <a class="text-link" href={`/insights/${a.slug}/`}>
                {a.title} →
              </a>
            ))}
        </div>
      </div>
    </article>
  </section>
  <CTA />
</Layout>
