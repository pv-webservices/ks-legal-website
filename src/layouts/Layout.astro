---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.png";
import Icon from "../components/Icon.astro";
import { contact, siteName, whatsapp } from "../data/site";
import { noindexPaths } from "../data/seo";
import { expertise } from "../data/expertise";
import { services } from "../data/services";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/cormorant-garamond/latin-700.css";
import "@fontsource/cormorant-garamond/latin-500-italic.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-600.css";
import "@fontsource/great-vibes/latin-400.css";
import headingFont from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url";
import bodyFont from "@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Page-specific JSON-LD, emitted alongside the site-wide organisation graph. */
  schema?: Record<string, unknown>;
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedTime?: string;
}
const {
  title = "Legal Counsel in Hyderabad",
  description = "KS Legal Consultants, led by Advocate Siri Swathi Katragadda. Strategic corporate and arbitration counsel for individuals, families and businesses in Hyderabad.",
  schema,
  noindex = noindexPaths.includes(Astro.url.pathname),
  ogType = "website",
  publishedTime,
} = Astro.props;
/** Keep titles within ~65 characters so search results do not truncate them. */
const TITLE_MAX = 65;
const fullTitle = title.includes(siteName)
  ? title
  : [`${title} | ${siteName}`, `${title} | KS Legal`].find((t) => t.length <= TITLE_MAX) ?? title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
const ogImage = new URL("/images/og-image.jpg", Astro.site).href;
const logoUrl = new URL(logo.src, Astro.site).href;
const nav = [
  ["Home", "/"],
  ["About", "/about/"],
  ["Team", "/team/"],
  ["Insights", "/insights/"],
  ["Contact", "/contact/"],
];
const menus = [
  { label: "Our Expertise", href: "/expertise/", items: expertise },
  { label: "Our Services", href: "/services/", items: services },
];
const active = (path: string) =>
  path === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(path);
const waLink = `https://wa.me/${whatsapp}?text=${encodeURIComponent("Hello KS Legal Consultants, I would like to discuss a legal matter.")}`;
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LegalService",
      "@id": `${siteUrl}#organization`,
      name: siteName,
      url: siteUrl,
      logo: logoUrl,
      image: ogImage,
      description:
        "Hyderabad law firm led by Advocate Siri Swathi Katragadda, advising on civil, criminal, family, property, consumer and corporate matters.",
      email: contact.email,
      telephone: "+917660000787",
      founder: { "@id": `${siteUrl}founder/#person` },
      address: {
        "@type": "PostalAddress",
        streetAddress:
          "BMR Heights, Plot No. 8, Flat No. 601, Srinivasa Colony, Hydernagar, KPHB",
        addressLocality: "Hyderabad",
        addressRegion: "Telangana",
        postalCode: "500090",
        addressCountry: "IN",
      },
      hasMap: contact.map,
      areaServed: [...contact.operatingAreas, "Telangana", "Andhra Pradesh"],
      knowsLanguage: ["en", "te", "hi"],
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}founder/#person`,
      name: "Siri Swathi Katragadda",
      jobTitle: "Advocate & Founder",
      worksFor: { "@id": `${siteUrl}#organization` },
      url: `${siteUrl}founder/`,
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: siteName,
      url: siteUrl,
      inLanguage: "en-IN",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0B1F33" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <link rel="canonical" href={canonical} />
      </>
    )}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Advocate Siri Swathi Katragadda at her chamber desk, KS Legal Consultants" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonLd(siteSchema)} />
    {schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topbar">
      <div class="container container-wide topbar-inner">
        <span class="office"><Icon name="pin" size={15} /> Operating Areas: {contact.operatingAreas.join(" | ")}</span>
        <div class="topbar-links">
          <a href="tel:+917660000787"><Icon name="phone" size={14} /> +91 7660000787</a>
          <a class="top-email" href={`mailto:${contact.email}`}><Icon name="mail" size={14} /> {contact.email}</a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container container-wide header-inner">
        <a href="/" class="brand" aria-label="KS Legal Consultants home">
          <Image src={logo} alt="" width={120} height={84} format="webp" loading="eager" />
          <span class="brand-text">
            <strong>KS LEGAL</strong>
            <strong>CONSULTANTS</strong>
            <small>Justice <i>|</i> People <i>|</i> Progress</small>
          </span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          {nav.slice(0, 2).map(([label, path]) => (
            <a href={path} aria-current={active(path) ? "page" : undefined}>{label}</a>
          ))}
          {menus.map((m, mi) => (
            <div class="nav-dropdown">
              <a href={m.href} aria-current={active(m.href) ? "page" : undefined}>{m.label}</a>
              <button class="dropdown-toggle" aria-expanded="false" aria-controls={`menu-${mi}`} aria-label={`Show ${m.label} links`}>
                <Icon name="chevron-down" size={16} />
              </button>
              <div class="dropdown-panel" id={`menu-${mi}`}>
                {m.items.map((it) => (
                  <a href={`/${it.group}/${it.slug}/`}>
                    <span class="dd-icon"><Icon name={it.icon} size={18} /></span>
                    <span>{it.title}</span>
                  </a>
                ))}
                <a class="dd-all" href={m.href}>View all {m.label.replace("Our ", "").toLowerCase()} <Icon name="arrow" size={15} /></a>
              </div>
            </div>
          ))}
          {nav.slice(2).map(([label, path]) => (
            <a href={path} aria-current={active(path) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <a class="button nav-cta" href="/consultation/">
          <span>Book Consultation</span> <Icon name="arrow" size={18} />
        </a>
        <button class="menu-toggle" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu">
          <Icon name="menu" size={26} />
        </button>
      </div>
    </header>
    <div class="drawer" id="mobile-nav" hidden>
      <div class="drawer-backdrop" data-close-drawer></div>
      <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
        <div class="drawer-head">
          <span class="drawer-title">KS Legal Consultants</span>
          <button class="drawer-close" data-close-drawer aria-label="Close menu">
            <Icon name="close" size={24} />
          </button>
        </div>
        <nav aria-label="Mobile navigation">
          {nav.slice(0, 2).map(([label, path], i) => (
            <a href={path} style={`--i:${i}`} aria-current={active(path) ? "page" : undefined}>
              {label} <Icon name="chevron-right" size={18} />
            </a>
          ))}
          {menus.map((m, mi) => (
            <details class="drawer-group" style={`--i:${mi + 2}`}>
              <summary>{m.label} <Icon name="chevron-down" size={18} /></summary>
              <div class="drawer-sub">
                {m.items.map((it) => (
                  <a href={`/${it.group}/${it.slug}/`}><Icon name={it.icon} size={16} /> {it.title}</a>
                ))}
                <a class="dd-all" href={m.href}>View all <Icon name="arrow" size={15} /></a>
              </div>
            </details>
          ))}
          {nav.slice(2).map(([label, path], i) => (
            <a href={path} style={`--i:${i + 4}`} aria-current={active(path) ? "page" : undefined}>
              {label} <Icon name="chevron-right" size={18} />
            </a>
          ))}
        </nav>
        <div class="drawer-actions">
          <a class="button" href="/consultation/"><span>Book Consultation</span> <Icon name="arrow" size={18} /></a>
          <a class="button button-outline" href="tel:+917660000787"><span>Call +91 7660000787</span> <Icon name="phone" size={18} /></a>
        </div>
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand brand-light" href="/">
            <Image src={logo} alt="" width={96} height={67} format="webp" loading="lazy" />
            <span class="brand-text">
              <strong>KS LEGAL CONSULTANTS</strong>
              <small>Justice <i>|</i> People <i>|</i> Progress</small>
            </span>
          </a>
          <p>
            Strategic legal practice with core team and senior expertise
            offering ethical, and client-focused legal solutions for
            individuals, families and businesses.
          </p>
          <div class="footer-social">
            <a href={waLink} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp"><Icon name="whatsapp" size={18} /></a>
            <a href="tel:+917660000787" aria-label="Call +91 7660000787"><Icon name="phone" size={18} /></a>
            <a href={`mailto:${contact.email}`} aria-label="Email the firm"><Icon name="mail" size={18} /></a>
            <a href={contact.map} target="_blank" rel="noopener noreferrer" aria-label="Office location on Google Maps"><Icon name="pin" size={18} /></a>
          </div>
        </div>
        <div>
          <h2>Quick Links</h2>
          {[
            ["Home", "/"],
            ["About the Firm", "/about/"],
            ["Our Founder", "/founder/"],
            ["Practice Areas", "/practice-areas/"],
            ["Team", "/team/"],
            ["Success Stories", "/success-stories/"],
            ["Insights", "/insights/"],
            ["Contact", "/contact/"],
          ].map(([label, path]) => <a href={path}>{label}</a>)}
        </div>
        <div>
          <h2>Our Expertise</h2>
          {expertise.map((p) => <a href={`/expertise/${p.slug}/`}>{p.title}</a>)}
        </div>
        <div>
          <h2>Our Services</h2>
          {services.map((p) => <a href={`/services/${p.slug}/`}>{p.title}</a>)}
        </div>
        <div class="footer-contact">
          <h2>Contact Information</h2>
          <p><Icon name="pin" size={18} /> <span>{contact.address}</span></p>
          <p><Icon name="landmark" size={18} /> <span><strong>Operating Areas:</strong> {contact.operatingAreas.join(" | ")}</span></p>
          <p><Icon name="phone" size={18} /> <span><a href="tel:+917660000787">+91 7660000787</a></span></p>
          <p><Icon name="mail" size={18} /> <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
          <p><Icon name="clock" size={18} /> <span>Consultations by appointment</span></p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} KS Legal Consultants. All rights reserved.</span>
        <div>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href="/disclaimer/">Disclaimer</a>
        </div>
      </div>
      <p class="container footer-note">
        As per the rules of the Bar Council of India, advocates are not permitted
        to solicit work or advertise. This website provides general information
        only and does not constitute legal advice or create an advocate–client
        relationship. Past outcomes do not guarantee future results.
      </p>
    </footer>

    <div class="quick-actions" aria-label="Quick contact">
      <a class="qa-call" href="tel:+917660000787"><Icon name="phone" size={20} /><span>Call</span></a>
      <a class="qa-whatsapp" href={waLink} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20} /><span>WhatsApp</span></a>
      <a class="qa-book" href="/consultation/"><Icon name="calendar" size={20} /><span>Book</span></a>
    </div>
    <a class="float-whatsapp" href={waLink} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
      <Icon name="whatsapp" size={28} />
    </a>
    <button class="to-top" aria-label="Back to top" hidden>
      <svg class="to-top-ring" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" /></svg>
      <Icon name="arrow-up" size={20} />
    </button>

    <dialog class="bci-dialog" aria-labelledby="bci-title">
      <div class="bci-inner">
        <Image src={logo} alt="" width={90} height={63} format="webp" loading="lazy" />
        <h2 id="bci-title">Disclaimer</h2>
        <p>
          The Bar Council of India does not permit advocates to solicit work or
          advertise. By clicking “I Agree”, you acknowledge that:
        </p>
        <ul>
          <li>There has been no advertisement, personal communication, solicitation or inducement of any sort from KS Legal Consultants or its members.</li>
          <li>You wish to learn more about KS Legal Consultants for your own information and use.</li>
          <li>The information on this website is for general awareness only and is not legal advice. It does not create an advocate–client relationship.</li>
        </ul>
        <div class="bci-actions">
          <button class="button" data-bci-accept><span>I Agree</span> <Icon name="check" size={18} /></button>
          <a class="text-link" href="/disclaimer/">Read full disclaimer</a>
        </div>
      </div>
    </dialog>

    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
