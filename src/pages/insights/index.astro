---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Insights from "../../components/Insights.astro";
import Publications from "../../components/Publications.astro";
import CTA from "../../components/CTA.astro";
---

<Layout
  title="Insights & Legal Awareness"
  description="Legal-awareness articles plus recognition and publications from KS Legal Consultants, including the IBA Annual Conference 2026 in Copenhagen."
>
  <PageHero
    eyebrow="Insights"
    title="Knowledge brings perspective."
    description="Thoughtful starting points for understanding legal matters and asking the right questions."
  />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span></span>Legal Awareness</p>
          <h2>Latest articles</h2>
        </div>
      </div>
      <Insights />
      <p class="small">
        These resources provide general information only and are not a
        substitute for advice on your specific circumstances.
      </p>
    </div>
  </section>
  <section class="section insights-section" id="publications" aria-labelledby="publications-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><span></span>Recognition &amp; Publications</p>
          <h2 id="publications-title">Featured, published &amp; recognised</h2>
        </div>
        <p>International engagement, editorial features and legal-awareness writing from our practice.</p>
      </div>
      <Publications />
    </div>
  </section>
  <CTA />
</Layout>
