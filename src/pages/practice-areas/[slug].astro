---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CTA from "../../components/CTA.astro";
import { practices } from "../../data/site";
import Icon from "../../components/Icon.astro";
import { Image } from "astro:assets";
import consultation from "../../assets/gen/consultation.webp";
export function getStaticPaths() {
  return practices.map((practice) => ({
    params: { slug: practice.slug },
    props: { practice },
  }));
}
const { practice: p } = Astro.props;
---

<Layout title={`${p.title} in Hyderabad`} description={p.description}>
  <PageHero
    eyebrow={p.title}
    crumbs={[["Practice Areas", "/practice-areas/"]]}
    title={p.title}
    description={p.description}
  />
  <section class="section">
    <div class="container service-layout">
      <div class="editorial" data-reveal>
        <h2>A considered way forward.</h2>
        <p>{p.detail}</p>
        <h2>How we can assist</h2>
        <p>
          We assess the available records, discuss your priorities and explain
          the potential courses of action. The scope of representation and
          professional fees are discussed before an engagement is confirmed.
        </p>
        <ul>
          {p.matters.map((m) => (
            <li>{m}</li>
          ))}
        </ul>
        <h2>Our approach</h2>
        <div class="steps">
          <div>
            <span>01</span>
            <h3>Listen & understand</h3>
            <p>
              Tell us the background, your concerns and any immediate deadlines.
            </p>
          </div>
          <div>
            <span>02</span>
            <h3>Review & advise</h3>
            <p>
              We review the relevant documents and discuss your available
              options.
            </p>
          </div>
          <div>
            <span>03</span>
            <h3>Agree on next steps</h3>
            <p>
              Move forward with an understood scope, process and fee
              arrangement.
            </p>
          </div>
        </div>
        <div class="faq">
          <h2>Common questions</h2>
          <details>
            <summary>What should I bring to a consultation?</summary>
            <p>
              Bring relevant agreements, notices, correspondence and a short
              chronology. For {p.title.toLowerCase()}, include any documents
              relating to the matters listed above. Contact us first before
              sending sensitive records.
            </p>
          </details>
          <details>
            <summary>Can you advise on my specific situation?</summary>
            <p>
              Advice depends on the facts, documents, applicable law and any
              conflicts of interest. An initial conversation helps us assess
              whether we can assist.
            </p>
          </details>
          <details>
            <summary>How are fees and timelines determined?</summary>
            <p>
              These depend on the nature and scope of the work. We discuss fees
              before engagement. Court schedules and other external factors can
              affect timing; outcomes and completion dates cannot be guaranteed.
            </p>
          </details>
        </div>
        <p class="small">
          General information only. Please obtain advice specific to your
          circumstances.
        </p>
      </div>
      <aside class="service-aside">
        <div class="aside-image">
          <Image src={consultation} alt="" widths={[400, 680]} sizes="340px" format="webp" loading="lazy" />
        </div>
        <h2>Other practice areas</h2>
        {practices
          .filter((other) => other.slug !== p.slug)
          .map((other) => (
            <a href={`/practice-areas/${other.slug}/`}>{other.title} <Icon name="chevron-right" size={16} /></a>
          ))}
        <a class="button" href="/consultation/"><span>Discuss Your Matter</span> <Icon name="arrow" size={18} /></a>
        <a class="button button-ghost" href="tel:+918008286868"><Icon name="phone" size={18} /> <span>Call 8008286868</span></a>
      </aside>
    </div>
  </section>
  <CTA />
</Layout>
