---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import founderDesk from "../assets/people/founder-office.jpeg";
import team from "../assets/firm/legal-team-high-court.webp";
import editorial1 from "../assets/people/founder-supreme-court.jpeg";
import editorial2 from "../assets/editorial/femhonour-feature.jpeg";
import newspaper from "../assets/editorial/property-awareness-column.jpeg";
import pillars from "../assets/illustrations/hero-pillars.webp";
import library from "../assets/illustrations/library.webp";
import consultation from "../assets/illustrations/consultation.webp";
import Icon from "../components/Icon.astro";
import PracticeGrid from "../components/PracticeGrid.astro";
import Insights from "../components/Insights.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import ContactDetails from "../components/ContactDetails.astro";
import ContactForm from "../components/ContactForm.astro";
import MapEmbed from "../components/MapEmbed.astro";
import { values, stats, process, practices, faqs } from "../data/site";
import { expertise } from "../data/expertise";
import { services } from "../data/services";
const tabGroups = [
  { id: "expertise", label: "Our Expertise", href: "/expertise/", items: expertise },
  { id: "services", label: "Our Services", href: "/services/", items: services },
];


const media = [
  { src: editorial1, alt: "Advocate Siri Swathi Katragadda outside the Supreme Court of India", title: "Appearing before the Supreme Court of India", source: "Adv. Siri Swathi Katragadda", href: "/founder/", pos: "50% 30%" },
  { src: editorial2, alt: "Femhonour, September 2025, page 19: awards and interview", title: "Awards, achievements & interview", source: "Femhonour · September 2025 · p.19", href: "/founder/" },
  { src: newspaper, alt: "Newspaper column by Katragadda Siri Swathi: The House of Dreams, or the Beginning of Disaster?", title: "The House of Dreams, or the Beginning of Disaster?", source: "Legal awareness column by the founder", href: "/insights/property-due-diligence/", pos: "4% 50%" },
  { src: team, alt: "KS Legal team at the Andhra Pradesh High Court", title: "Success at the A.P. High Court", source: "K.S. Legal Team", href: "/success-stories/", pos: "40% 30%" },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.slice(0, 6).map(([q, a]) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<Layout
  title="KS Legal Consultants | Corporate & Arbitration Counsel, Hyderabad"
  description="Hyderabad law firm led by Advocate Siri Swathi Katragadda. Civil, criminal, family, property, corporate and arbitration counsel for individuals and businesses."
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-texture" aria-hidden="true">
      <Image src={pillars} alt="" widths={[800, 1376]} sizes="60vw" format="webp" loading="eager" />
    </div>
    <div class="hero-media">
      <figure class="hero-portrait">
        <Image
          src={founderDesk}
          alt="Advocate Siri Swathi Katragadda, Founder of KS Legal Consultants, at her chamber desk"
          widths={[640, 960, 1400]}
          sizes="(max-width: 900px) 100vw, 62vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <strong>Adv. Siri Swathi Katragadda</strong>
          <span>Founder &amp; Partner</span>
        </figcaption>
      </figure>
    </div>
    <div class="container container-wide hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">Experience <i></i> Integrity <i></i> Results</p>
        <h1 id="hero-title">
          Strategic Corporate &amp; Arbitration Counsel for
          <em>Individuals, Families &amp; Businesses</em>
        </h1>
        <p class="hero-lead">
          <strong>KS Legal Consultants</strong>, led by Advocate Siri Swathi
          Katragadda, provides result-oriented legal solutions with integrity,
          empathy and a commitment to justice — combining deep litigation
          experience with a strong understanding of governance and policy.
        </p>
        <div class="hero-buttons">
          <a class="button" href="/consultation/"><span>Get Legal Advice</span> <Icon name="arrow" size={18} /></a>
          <a class="button button-outline" href="#practice-areas"><span>View Practice Areas</span></a>
        </div>
        <a class="hero-call" href="tel:+917660000787">
          <span class="pulse"><Icon name="phone" size={18} /></span>
          <span><small>Speak to us today</small> <span class="phone-num">+91 7660000787</span></span>
        </a>
      </div>
      <ul class="stat-cards" aria-label="Our practice at a glance">
        {stats.map((s, i) => (
          <li class="stat-card" data-touch style={`--d:${300 + i * 120}ms`}>
            <span class="stat-icon"><Icon name={s.icon} size={26} /></span>
            {s.value ? (
              <strong><span data-count={s.value}>{s.value}</span>{s.suffix}</strong>
            ) : (
              <strong class="stat-word">{s.label}</strong>
            )}
            {s.value > 0 && <span class="stat-label">{s.label}</span>}
            <small>{s.note}</small>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {practices.map((p) => (
            <span><Icon name="scale" size={18} /> {p.title}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- PRACTICE AREAS -->
  <section class="section practice-section" id="practice-areas" aria-labelledby="practice-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><span></span>What We Do</p>
          <h2 id="practice-title">Our Practice Areas</h2>
        </div>
        <a class="text-link" href="/practice-areas/">View all practice areas <Icon name="arrow" size={16} /></a>
      </div>
      <PracticeGrid />
    </div>
  </section>

  <!-- WHY CHOOSE -->
  <section class="section why-section" aria-labelledby="why-title">
    <div class="why-bg" aria-hidden="true">
      <Image src={library} alt="" widths={[800, 1376]} sizes="100vw" format="webp" loading="lazy" data-parallax="0.18" />
    </div>
    <div class="container">
      <div class="section-head section-head-light" data-reveal>
        <div>
          <p class="kicker kicker-light"><span></span>Our Promise</p>
          <h2 id="why-title">Why Choose KS Legal Consultants</h2>
        </div>
        <p>Every legal matter has a human story. We make understanding yours our first priority.</p>
      </div>
      <div class="values-grid">
        {values.map(([icon, title, description], i) => (
          <div class="value-card" data-reveal="zoom" data-touch style={`--d:${i * 100}ms`}>
            <span class="icon-badge"><Icon name={icon} size={32} /></span>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS (sticky) -->
  <section class="section process-section" aria-labelledby="process-title">
    <div class="container process-grid">
      <div class="process-sticky">
        <p class="kicker"><span></span>How We Work</p>
        <h2 id="process-title">A clear path from your first call to resolution</h2>
        <p>
          Legal matters feel less daunting when you know what happens next.
          Here is how we guide every client, step by step.
        </p>
        <div class="process-image">
          <Image src={consultation} alt="An advocate discussing a case file with clients" widths={[480, 760]} sizes="(max-width: 900px) 92vw, 460px" format="webp" loading="lazy" />
        </div>
      </div>
      <ol class="process-steps" data-progress>
        {process.map((step, i) => (
          <li class="process-step" data-reveal="right">
            <span class="step-marker"><Icon name={step.icon} size={24} /></span>
            <div class="step-card" data-touch>
              <span class="step-number">Step 0{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- EXPERTISE & SERVICES (tabs) -->
  <section class="section es-section" aria-labelledby="es-title" data-tabs>
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><span></span>Expertise &amp; Services</p>
          <h2 id="es-title">Find the right legal help</h2>
        </div>
        <div class="tab-list" role="tablist" aria-label="Expertise and services">
          {tabGroups.map((g, i) => (
            <button role="tab" id={`tab-${g.id}`} aria-controls={`panel-${g.id}`} aria-selected={i === 0 ? "true" : "false"}>{g.label}</button>
          ))}
        </div>
      </div>
      {tabGroups.map((g) => (
        <div class="tab-panel" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`}>
          <h3 class="tab-panel-title">{g.label}</h3>
          <div class="es-grid">
            {g.items.map((it, i) => (
              <a class="es-card" href={`/${it.group}/${it.slug}/`} data-touch style={`--i:${i}`}>
                <span class="icon-badge"><Icon name={it.icon} size={24} /></span>
                <span class="es-text">
                  <strong>{it.title}</strong>
                  <small>{it.summary}</small>
                </span>
                <Icon name="arrow-up-right" size={18} class="es-arrow" />
              </a>
            ))}
          </div>
          <a class="text-link es-all" href={g.href}>View all {g.label.replace("Our ", "").toLowerCase()} <Icon name="arrow" size={16} /></a>
        </div>
      ))}
    </div>
  </section>

  <!-- SUCCESS -->
  <section class="section success-section" aria-labelledby="success-title">
    <div class="container success-grid">
      <div class="success-media" data-reveal="left">
        <div class="zoom-frame">
          <Image src={team} alt="KS Legal team at the Andhra Pradesh High Court: We successfully won the case in A.P. High Court" widths={[640, 1000, 1600]} sizes="(max-width: 900px) 92vw, 58vw" format="webp" loading="lazy" data-scroll-zoom />
        </div>
      </div>
      <div class="success-copy" data-reveal>
        <p class="kicker"><span></span>Our Success Stories</p>
        <h2 id="success-title">Delivering Results. Building Trust.</h2>
        <p>
          Our team has successfully represented clients in the Andhra Pradesh
          High Court and various lower courts, securing favourable outcomes in
          complex matters.
        </p>
        <div class="featured-success" data-touch>
          <span class="icon-badge"><Icon name="trophy" size={28} /></span>
          <div>
            <small>Featured Success</small>
            <h3>A.P. High Court Matter</h3>
            <p>
              Our legal team successfully won a significant case in the A.P. High
              Court, reflecting our commitment, legal expertise and strategic
              approach.
            </p>
          </div>
        </div>
        <a class="text-link" href="/success-stories/">Explore our success stories <Icon name="arrow" size={16} /></a>
        <p class="small">Past outcomes do not guarantee similar results. Every matter depends on its own facts.</p>
      </div>
    </div>
  </section>

  <!-- MEDIA / RECOGNITION CAROUSEL -->
  <section class="section media-section" aria-labelledby="media-title" data-carousel>
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><span></span>Recognition &amp; Publications</p>
          <h2 id="media-title">Featured, Published &amp; Recognised</h2>
        </div>
        <div class="carousel-controls">
          <button class="round-btn" data-prev aria-label="Previous"><Icon name="chevron-left" size={20} /></button>
          <button class="round-btn" data-next aria-label="Next"><Icon name="chevron-right" size={20} /></button>
        </div>
      </div>
    </div>
    <div class="carousel-track" tabindex="0" aria-label="Recognition and publications">
      {media.map((m) => (
        <a class="media-card" href={m.href} data-touch>
          <span class="media-img">
            <Image src={m.src} alt={m.alt} widths={[420, 640, 900]} sizes="(max-width: 700px) 78vw, 380px" format="webp" loading="lazy" style={m.pos ? `--pos:${m.pos}` : undefined} />
          </span>
          <span class="media-body">
            <small>{m.source}</small>
            <strong>{m.title}</strong>
            <span class="card-link">View <Icon name="arrow" size={15} /></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- INSIGHTS -->
  <section class="section insights-section" aria-labelledby="insights-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><span></span>Knowledge Empowers</p>
          <h2 id="insights-title">Insights &amp; Legal Awareness</h2>
        </div>
        <a class="text-link" href="/insights/">View all articles <Icon name="arrow" size={16} /></a>
      </div>
      <Insights />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="faq-intro" data-reveal="left">
        <p class="kicker"><span></span>FAQs</p>
        <h2 id="faq-title">Frequently Asked Questions</h2>
        <p>Answers to common questions about consultations, courts and the matters we handle.</p>
        <div class="faq-callout" data-touch>
          <span class="icon-badge"><Icon name="phone" size={24} /></span>
          <div>
            <strong>Still have a question?</strong>
            <a href="tel:+917660000787">Call +91 7660000787</a>
          </div>
        </div>
      </div>
      <FAQ limit={6} />
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, "\\u003c")} />
  </section>

  <CTA />

  <!-- CONTACT -->
  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="container contact-home-grid">
      <div class="contact-info" data-reveal="left">
        <p class="kicker"><span></span>Get In Touch</p>
        <h2 id="contact-title">Contact Us</h2>
        <p>We are here to help. Reach out for consultations, legal support or any queries. Our team will get back to you promptly.</p>
        <ContactDetails />
      </div>
      <MapEmbed />
      <div data-reveal="right">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>
