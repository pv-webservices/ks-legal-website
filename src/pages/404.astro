---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";

const popular: [string, string][] = [
  ["Our Expertise", "/expertise/"],
  ["Our Services", "/services/"],
  ["Practice Areas", "/practice-areas/"],
  ["About the Firm", "/about/"],
  ["Legal Insights", "/insights/"],
  ["Book a Consultation", "/consultation/"],
];
---

<Layout
  title="Page Not Found (404)"
  description="The page you requested could not be found on the KS Legal Consultants website."
  noindex
>
  <PageHero
    eyebrow="404 · Page not found"
    title="Let’s get you back on track."
    description="The page you’re looking for may have moved, or the address may be incomplete."
  />
  <section class="section">
    <div class="container editorial">
      <div class="not-found-actions">
        <a class="button" href="/"><span>Return to Home</span> <Icon name="arrow" size={18} /></a>
        <a class="button button-outline" href="/contact/"><span>Contact the Firm</span></a>
      </div>
      <h2>Popular pages</h2>
      <ul>
        {popular.map(([label, href]) => <li><a class="text-link" href={href}>{label}</a></li>)}
      </ul>
      <p class="small">
        Need help now? Call <a href="tel:+917660000787">+91 7660000787</a>.
      </p>
    </div>
  </section>
</Layout>
