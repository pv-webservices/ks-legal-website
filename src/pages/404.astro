---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="Page Not Found" noindex>
  <PageHero
    eyebrow="404 · Page not found"
    title="Let’s get you back on track."
    description="The page you’re looking for may have moved, or the address may be incomplete."
  />
  <section class="section">
    <div class="container">
      <div class="not-found-actions">
        <a class="button" href="/"><span>Return to Home</span></a>
        <a class="button button-outline" href="/practice-areas/"><span>Practice Areas</span></a>
        <a class="text-link" href="/contact/">Contact the firm →</a>
      </div>
    </div>
  </section>
</Layout>
