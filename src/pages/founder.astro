---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import Icon from "../components/Icon.astro";
import { Image, getImage } from "astro:assets";
import founder from "../assets/people/founder-office.jpeg";
import editorial1 from "../assets/people/founder-supreme-court.jpeg";
import editorial2 from "../assets/editorial/femhonour-feature.jpeg";
import iba1 from "../assets/events/iba-denmark-1.jpeg";
import iba2 from "../assets/events/iba-denmark-2.jpeg";
// Full-size views are optimised WebP rather than the original camera files.
const [editorial1Large, editorial2Large, iba1Large, iba2Large] = await Promise.all(
  [editorial1, editorial2, iba1, iba2].map((src) => getImage({ src, width: 1600, format: "webp" })),
);
const ibaPdf = "/documents/iba-denmark-event.pdf";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    "@id": new URL("/founder/#person", Astro.site).href,
    name: "Siri Swathi Katragadda",
    jobTitle: "Advocate & Founder",
    image: new URL(editorial1Large.src, Astro.site).href,
    worksFor: { "@id": new URL("/#organization", Astro.site).href },
    award: "Young Researcher Award (InSc)",
    knowsAbout: ["Civil litigation", "Criminal law", "Family law", "Property law", "Corporate advisory", "Governance and public policy"],
  },
};
---

<Layout
  title="Siri Swathi Katragadda — Advocate & Founder"
  description="The professional profile of Siri Swathi Katragadda, founder of KS Legal Consultants, with experience spanning litigation, governance and community legal support."
  schema={personSchema}
>
  <PageHero
    eyebrow="Our founder"
    title="Siri Swathi Katragadda"
    description="Advocate & Founder, KS Legal Consultants"
  />
  <section class="section">
    <div class="container split-content">
      <div data-reveal="left">
        <Image
          src={founder}
          alt="Advocate Siri Swathi Katragadda at her office"
          widths={[640, 960]}
          sizes="(max-width: 960px) 92vw, 540px"
          format="webp"
        />
      </div>
      <div data-reveal>
        <p class="kicker"><span></span>Advocacy With Purpose</p>
        <h2>Legal insight. A human perspective.</h2>
        <div class="stat-row">
          <div><strong><span data-count="13">13</span>+</strong><span>Years of experience</span></div>
          <div><strong><span data-count="200">200</span>+</strong><span>Cases handled</span></div>
          <div><strong><span data-count="2000">2000</span>+</strong><span>Participants trained on child protection</span></div>
        </div>
        <p>
          Siri Swathi Katragadda brings together legal practice and development
          experience. Her work spans litigation, advisory matters and a
          commitment to making legal support accessible.
        </p>
        <p>
          She has over 13 years of experience in litigation, governance and
          sustainable development, and has handled 200+ matters across civil,
          corporate, criminal and family law. She has appeared before the
          Supreme Court and several High Courts.
        </p>
        <h3>Professional philosophy</h3>
        <p>
          Careful listening and practical guidance are central to her approach.
          Every matter is considered in light of its facts, its legal context
          and the people it affects.
        </p>
        <a class="button" href="/consultation/"><span>Discuss Your Legal Matter</span> <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container editorial" data-reveal>
      <h2>A foundation across disciplines</h2>
      <p>
        She holds master’s degrees in Sociology and Business Administration and
        a degree in Law, and is pursuing a Ph.D. in Sociology.
      </p>
      <h2>Governance, policy & research</h2>
      <p>
        As Knowledge Manager at the Centre for Good Governance, she led projects
        with UNICEF, SCCL and the Government of India on child budgeting, coal
        mining evaluation and district reforms, and trained over 2,000
        participants on child protection laws. She has presented research
        nationally and internationally on governance, water conservation and
        health policy.
      </p>
      <h2>Community & legal aid</h2>
      <p>
        Her work includes legal support for underprivileged women and senior
        citizens, with attention to domestic violence, family concerns and
        property-related matters.
      </p>
      <h2>Recognition & editorial feature</h2>
      <p>
        She is a recipient of the Young Researcher Award (InSc). Her legal and
        development work was featured in Femhonour magazine (September 2025) as
        “Super Woman – Most Inspiring Advocate”.
      </p>
    </div>
    <div class="container media-grid">
      <a
        href={editorial1Large.src}
        aria-label="View photograph of Siri Swathi Katragadda at the Supreme Court of India"
      >
        <Image
          src={editorial1}
          alt="Advocate Siri Swathi Katragadda outside the Supreme Court of India"
          width={650}
          format="webp"
          loading="lazy"
        />
      </a>
      <a
        href={editorial2Large.src}
        aria-label="View Femhonour feature, page 19"
      >
        <Image
          src={editorial2}
          alt="Femhonour September 2025, page 19: awards and interview"
          width={650}
          format="webp"
          loading="lazy"
        />
      </a>
    </div>
  </section>
  <section class="section practice-section" id="iba-copenhagen-2026">
    <div class="container editorial" data-reveal>
      <p class="kicker"><span></span>International Engagement</p>
      <h2>IBA Annual Conference 2026 — Copenhagen, Denmark</h2>
      <p>
        In October 2026, Advocate Siri Swathi Katragadda attended the
        International Bar Association (IBA) Annual Conference in Copenhagen as
        part of a delegation of advocates from South India. The programme
        covered international arbitration and dispute resolution, technology
        and AI in legal practice, and cross-border transactions, along with an
        Embassy of India session on the India–Denmark Green Strategic
        Partnership and the India–EU Free Trade Agreement.
      </p>
      <a class="button" href={ibaPdf} target="_blank" rel="noopener">
        <span>View Event Brochure (PDF)</span> <Icon name="file" size={18} />
      </a>
    </div>
    <div class="container media-grid event-grid">
      <a href={iba1Large.src} aria-label="View IBA Annual Conference 2026 Copenhagen photograph">
        <Image
          src={iba1}
          alt="Advocate Siri Swathi Katragadda at the IBA Annual Conference 2026, Copenhagen, Denmark"
          widths={[480, 720]}
          sizes="(max-width: 640px) 92vw, 460px"
          format="webp"
          loading="lazy"
        />
      </a>
      <a href={iba2Large.src} aria-label="View IBA Annual Conference 2026 event highlights">
        <Image
          src={iba2}
          alt="Event highlights from the IBA Annual Conference 2026 in Copenhagen, including the Embassy of India programme"
          widths={[640, 960, 1280]}
          sizes="(max-width: 640px) 92vw, 720px"
          format="webp"
          loading="lazy"
        />
      </a>
    </div>
  </section>
  <CTA />
</Layout>
